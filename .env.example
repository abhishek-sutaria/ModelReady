# ModelReady environment variables
# Copy to .env for local overrides. None are required for the MVP demo.

# --- Backend / combined Docker image ---

# Port the HTTP server binds to (Render/Railway set this automatically).
PORT=8080

# Comma-separated browser origins allowed to call the API.
# Use * for the public MVP demo. For a split Vercel+Render deploy, set your
# Vercel URL, e.g. https://modelready.vercel.app
CORS_ORIGINS=*

# Directory of built frontend assets served by FastAPI (same-origin deploy).
# Leave unset for API-only local development.
# STATIC_DIR=/app/backend/static

# --- Frontend (build-time, Vite) ---

# API origin baked into the frontend bundle.
# Leave empty when UI and API share one URL (recommended public deploy).
# Set to the backend URL only for a split deploy, e.g.:
# VITE_API_BASE_URL=https://modelready-api.onrender.com
VITE_API_BASE_URL=
